# Required — Gemini is used only as a feature extractor (per-criterion evidence
# scores), never to vote on approval. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — SEC EDGAR asks that requests carry a contact User-Agent. Set this to
# your own tool name + contact email; a generic default is used if unset.
EDGAR_USER_AGENT=FDA-Approval-Analyzer research@example.com

# Optional — enables the --telegram flag on fda_analyzer.py / biotech_catalyst_scanner.py.
# Without these set, --telegram prints a message and skips sending (never crashes).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
